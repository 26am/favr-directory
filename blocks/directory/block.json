{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "favr-directory/directory",
	"title": "Business Directory",
	"category": "widgets",
	"icon": "store",
	"description": "A searchable, filterable list of member businesses.",
	"keywords": [ "directory", "business", "members", "chamber", "listing" ],
	"textdomain": "favr-directory",
	"attributes": {
		"title": { "type": "string" },
		"perPage": { "type": "number" },
		"category": { "type": "string" },
		"level": { "type": "string" },
		"featuredOnly": { "type": "boolean" },
		"showSearch": { "type": "boolean" },
		"showLetters": { "type": "boolean" },
		"showLevelFilter": { "type": "boolean" },
		"showPagination": { "type": "boolean" },
		"layout": { "type": "string" },
		"order": { "type": "string" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "favr-directory-blocks",
	"style": "favr-directory"
}
