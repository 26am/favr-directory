{
  "name": "favr/favr-directory",
  "description": "Business directory for Chambers of Commerce and associations. Part of Favr Sites.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": {
    "psr-4": { "FavrDirectory\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "FavrDirectory\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.1.0" },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
